{
  "manifest_version": 3,
  "name": "Flow Automation",
  "version": "1.6.0",
  "description": "Automated batch wallpaper prompt generator with hardware-level Enter for Google Flow",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Automation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/*",
    "https://*.labs.google/*",
    "https://aitestkitchen.withgoogle.com/*",
    "https://*.aitestkitchen.withgoogle.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/*",
        "https://*.labs.google/*",
        "https://aitestkitchen.withgoogle.com/*",
        "https://*.aitestkitchen.withgoogle.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://*/*"]
    }
  ]
}
